<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      The theme the activity actually runs under; BridgeActivity swaps to it
      once the WebView is attached.

      `statusBarColor` / `navigationBarColor` are set here so the bars are
      already brand-coloured in the first frame rather than flickering from the
      platform default. Android 15+ ignores both under edge-to-edge enforcement,
      which is why `AppChrome` also paints its own scrims behind the system bars
      and sizes them from the real window insets.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/statusBar</item>
        <item name="android:navigationBarColor">@color/navigationBar</item>
        <!-- Coral is dark enough to carry white status icons; the white
             navigation bar needs the dark button treatment. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!--
      Launch theme: what the system draws between the icon tap and the activity
      existing. `android:background` covers Android 11 and below;
      `windowSplashScreen*` is what Android 12+ actually reads, and without it
      the system would substitute the launcher icon on its own background.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_brand_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
