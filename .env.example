# WeddingMall mobile — client environment (names/placeholders only; never commit real values)
#
# SECURITY: only the PUBLIC project URL and the anon/publishable key may exist in
# the client bundle (APK/IPA/JS). The service_role key, DB password and JWT secret
# must NEVER be placed in a VITE_ variable — the app refuses to boot if it detects one.
# Privileged operations must run through a Supabase Edge Function.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Data source for the service layer: "supabase" (live) | "fixtures" (offline demo)
VITE_DATA_SOURCE=supabase
