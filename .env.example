# WeddingMall — client environment (names only; never commit real values)
# Only the PUBLIC Supabase URL and publishable/anon key may exist client-side.
# The service/secret key, DB password and JWT secret must NEVER be placed here.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Data source for the repository layer: "fixtures" | "supabase"
VITE_DATA_SOURCE=fixtures
