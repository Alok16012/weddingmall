# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment — never commit real secrets
.env
.env.local
.env.*.local

# Test / build output
coverage

# Capacitor native projects
# Android and iOS are tracked because they carry launcher icons, splash assets,
# native behaviour and release settings that `cap add` cannot regenerate.
# Platform-level .gitignore files exclude generated web assets and build output.
.gradle/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/release/
# Copies of the signed APK/AAB, staged for handover. The bundle Play receives
# is built from source; a binary in the repo would only ever be a stale one.
release/
# Regenerated on every `cap sync` from dist/.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
# Signing material never belongs in the repo — it lives in ~/.weddingmall/.
*.jks
*.keystore
keystore.properties

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
.env*

# Supabase CLI scratch state — not part of the project
supabase/.temp/
